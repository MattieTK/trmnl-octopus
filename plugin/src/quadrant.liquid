{%- assign fields = trmnl.plugin_settings.custom_fields_values -%}
{%- assign name_1 = fields.appliance_1 | default: "Appliance 1" -%}
{%- assign name_2 = fields.appliance_2 | default: "Appliance 2" -%}
{%- assign appliance_names = name_1 | append: "|" | append: name_2 | split: "|" -%}
{%- comment -%}
  Quadrant. The OG shows the current price and the first best time; TRMNL X
  adds a compact chart underneath.
{%- endcomment -%}
<div class="layout layout--col gap--small">
{%- if ok != true -%}
  <div class="flex flex--col flex--center gap--small w--full">
    <span class="title lg:title--large">{% if setup %}Set up Agile Octopus prices{% else %}Prices unavailable{% endif %}</span>
    <span class="label label--small lg:label--base">{% if setup %}Choose your electricity region in the plugin settings on trmnl.com.{% else %}{{ error | default: "No data fetched yet" }}{% endif %}</span>
  </div>
{%- else -%}
  <div class="flex flex--col flex--left">
    <span class="label label--small lg:label--base">Now · {{ now.time }}</span>
    <span class="value value--xlarge value--tnums">{{ now.price }}p</span>
    <span class="label label--small lg:label--base">{{ now.vs_reference_pct | abs }}% {% if now.vs_reference_pct < 0 %}below{% else %}above{% endif %} {{ reference.short }}</span>
  </div>
  {%- render "agile_chart", slots: slots, windows: windows, chart: chart, reference: reference, slot_count: window.slot_count, names: appliance_names, cls: "hidden lg:block lg:portrait:hidden w--full h--28 flex-none", plot_h: 160, ts: 34, pid: "agile-q-x", hatch: false, labels: false, now: false -%}
  {%- render "agile_chart", slots: slots, windows: windows, chart: chart, reference: reference, slot_count: window.slot_count, names: appliance_names, cls: "hidden lg:portrait:block w--full h--64 flex-none", plot_h: 620, ts: 44, pid: "agile-q-xp", hatch: false, labels: false, now: false -%}
  {%- assign w = windows[0] -%}
  {%- if w and w.available -%}
  <span class="label label--small lg:label--base">{{ name_1 }}: {{ w.day }} {{ w.start }}–{{ w.end }} · {{ w.average }}p</span>
  {%- endif -%}
{%- endif -%}
</div>

<div class="title_bar">
  <span class="title">Agile Octopus</span>
  <span class="instance">{% if ok == true %}{{ region.name }}{% else %}setup needed{% endif %}</span>
</div>
