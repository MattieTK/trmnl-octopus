{%- comment -%}
  Agile Octopus prices – full view.
  Data comes from the Worker payload (see src/types.ts). The chart is inline
  SVG drawn by the agile_chart template in shared.liquid, so nothing runs at
  screenshot time. Styling uses framework classes and SVG presentation
  attributes only; there is no custom CSS.

  The layout targets three screens: the original TRMNL (md, 1-bit), TRMNL X
  in landscape (lg, 4-bit) and TRMNL X in portrait (lg:portrait). Responsive
  prefixes scale the text up on X, reflow the tiles and best-time cards in
  portrait, and pick which copy of the chart is visible.
{%- endcomment -%}
{%- assign fields = trmnl.plugin_settings.custom_fields_values -%}
{%- assign name_1 = fields.appliance_1 | default: "Appliance 1" -%}
{%- assign name_2 = fields.appliance_2 | default: "Appliance 2" -%}
{%- assign appliance_names = name_1 | append: "|" | append: name_2 | split: "|" -%}

<div class="layout layout--col gap--xsmall">
{%- if ok != true -%}
  {%- comment -%} Setup or error screen. `ok` is nil when TRMNL has no data yet. {%- endcomment -%}
  <div class="flex flex--col flex--center gap--medium w--full">
    {%- if setup -%}
    <span class="title title--large lg:title--xxlarge">Set up Agile Octopus prices</span>
    <span class="label lg:label--xlarge">{{ error }}</span>
    <div class="flex flex--col flex--left gap--small">
      <span class="label label--small lg:label--large">1. Open this plugin's settings on trmnl.com.</span>
      <span class="label label--small lg:label--large">2. Choose your electricity region: the last letter of your Agile tariff code (E-1R-AGILE-24-10-01-C is region C), or look it up by postcode at api.octopus.energy/v1/industry/grid-supply-points/?postcode=YOURPOSTCODE.</span>
      <span class="label label--small lg:label--large">3. Optionally name two appliances and their run times, then save. The screen updates at the next refresh.</span>
    </div>
    {%- elsif error -%}
    <span class="title title--large lg:title--xxlarge">Prices unavailable</span>
    <span class="label lg:label--xlarge">{{ error }}</span>
    <span class="label label--small lg:label--large">The Octopus Energy API did not answer. The plugin will try again at the next refresh.</span>
    {%- else -%}
    <span class="title title--large lg:title--xxlarge">Waiting for prices</span>
    <span class="label label--small lg:label--large">No data has been fetched yet. Check the plugin settings and polling URL.</span>
    {%- endif -%}
  </div>
{%- else -%}

  {%- comment -%}
    Headline tiles. Four on the OG, five on TRMNL X in landscape, and three
    columns of two rows in portrait, where a sixth tile (the average) fills
    the second row.
  {%- endcomment -%}
  {%- assign tile_label = "label label--small lg:label--base" -%}
  {%- assign tile_value = "value value--large lg:portrait:value--xlarge value--tnums" -%}
  <div class="grid grid--cols-4 lg:grid--cols-5 lg:portrait:grid--cols-3 gap--medium w--full">
    <div class="flex flex--col flex--left">
      <span class="{{ tile_label }}">Now · {{ now.time }}–{{ now.end }}</span>
      <span class="{{ tile_value }}">{{ now.price }}p</span>
      <span class="{{ tile_label }}">{{ now.vs_reference_pct | abs }}% {% if now.vs_reference_pct < 0 %}below{% else %}above{% endif %} {{ reference.short }}</span>
    </div>
    <div class="flex flex--col flex--left">
      {%- if next -%}
      <span class="{{ tile_label }}">Next · {{ next.time }}</span>
      <span class="{{ tile_value }}">{{ next.price }}p</span>
      <span class="{{ tile_label }}">{% if next.delta > 0 %}up {{ next.delta }}p{% elsif next.delta < 0 %}down {{ next.delta | abs }}p{% else %}no change{% endif %}</span>
      {%- else -%}
      <span class="{{ tile_label }}">Next</span>
      <span class="{{ tile_value }}">–</span>
      <span class="{{ tile_label }}">awaiting prices</span>
      {%- endif -%}
    </div>
    <div class="flex flex--col flex--left">
      <span class="{{ tile_label }}">Cheapest · {{ stats.min.day }} {{ stats.min.time }}</span>
      <span class="{{ tile_value }}">{{ stats.min.price }}p</span>
      <span class="{{ tile_label }}">average {{ stats.average }}p</span>
    </div>
    <div class="flex flex--col flex--left">
      <span class="{{ tile_label }}">Peak · {{ stats.max.day }} {{ stats.max.time }}</span>
      <span class="{{ tile_value }}">{{ stats.max.price }}p</span>
      <span class="{{ tile_label }}">{{ stats.negative_count }} negative slot{% if stats.negative_count != 1 %}s{% endif %}</span>
    </div>
    <div class="hidden lg:flex flex--col flex--left">
      <span class="{{ tile_label }}">{{ reference.label }}</span>
      <span class="{{ tile_value }}">{{ reference.price }}p</span>
      <span class="{{ tile_label }}">{{ stats.below_reference_pct }}% of slots cheaper</span>
    </div>
    <div class="hidden lg:portrait:flex flex--col flex--left">
      <span class="{{ tile_label }}">Average</span>
      <span class="{{ tile_value }}">{{ stats.average }}p</span>
      <span class="{{ tile_label }}">until {{ window.until }}</span>
    </div>
  </div>

  {%- comment -%}
    Chart. One copy per screen: the OG gets a short hatched chart for its
    1-bit panel; TRMNL X gets flat greys, wide in landscape and taller with
    larger text in portrait. The framework's visibility prefixes show one.
    Fixed heights and flex-none stop the flex column squeezing the SVG.
  {%- endcomment -%}
  {%- assign chart_label = "label label--small lg:label--base" -%}
  <div class="flex flex--col flex--stretch gap--xsmall w--full flex-none">
    <div class="flex flex--row flex--between">
      <span class="{{ chart_label }}">Prices until {{ window.until }} (p/kWh){% if window.tomorrow_pending %} · tomorrow's prices due about 16:00{% endif %}</span>
      <span class="{{ chart_label }}">dark bars below {{ reference.short }} · light bars above</span>
    </div>
    {%- render "agile_chart", slots: slots, windows: windows, chart: chart, reference: reference, slot_count: window.slot_count, names: appliance_names, cls: "block lg:hidden w--full h--36 flex-none", plot_h: 84, ts: 20, pid: "agile-full", hatch: true, labels: true, now: true -%}
    {%- render "agile_chart", slots: slots, windows: windows, chart: chart, reference: reference, slot_count: window.slot_count, names: appliance_names, cls: "hidden lg:block lg:portrait:hidden w--full h--96 flex-none", plot_h: 250, ts: 20, pid: "agile-full-x", hatch: false, labels: true, now: true -%}
    {%- render "agile_chart", slots: slots, windows: windows, chart: chart, reference: reference, slot_count: window.slot_count, names: appliance_names, cls: "hidden lg:portrait:block w--full h--72 flex-none", plot_h: 230, ts: 28, pid: "agile-full-xp", hatch: false, labels: true, now: true -%}
  </div>

  {%- comment -%} Best times: side by side, stacked in portrait on TRMNL X {%- endcomment -%}
  {%- if windows.size > 0 -%}
  <div class="grid grid--cols-2 lg:portrait:grid--cols-1 gap--medium w--full">
    {%- for w in windows -%}
    <div class="flex flex--col flex--left gap--xsmall p--2 rounded--medium bg--gray-75">
      <span class="label label--small lg:label--base">{{ appliance_names[forloop.index0] }} · {{ w.hours }}h</span>
      {%- if w.available -%}
      <span class="value value--base value--tnums">{{ w.day }} {{ w.start }}–{{ w.end }}</span>
      <span class="label label--small lg:label--base">average {{ w.average }}p · {{ w.vs_reference_pct | abs }}% {% if w.vs_reference_pct < 0 %}below{% else %}above{% endif %} {{ reference.short }}</span>
      {%- else -%}
      <span class="value value--base">Not enough prices yet</span>
      <span class="label label--small lg:label--base">check again after 16:00</span>
      {%- endif -%}
    </div>
    {%- endfor -%}
  </div>
  {%- else -%}
  <span class="label label--small lg:label--base">Set appliance run times in the plugin settings to see the best times to run them.</span>
  {%- endif -%}

  <span class="label label--small lg:label--base">Data: Octopus Energy public API · Not an Octopus product{% if stale %} · prices may be out of date{% endif %}</span>
{%- endif -%}
</div>

<div class="title_bar">
  <span class="title">Agile Octopus prices</span>
  <span class="instance">{% if ok == true %}{{ region.name }} · slot {{ slot_label }}{% else %}setup needed{% endif %}</span>
</div>
