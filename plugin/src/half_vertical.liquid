{%- assign fields = trmnl.plugin_settings.custom_fields_values -%}
{%- assign name_1 = fields.appliance_1 | default: "Appliance 1" -%}
{%- assign name_2 = fields.appliance_2 | default: "Appliance 2" -%}
{%- assign appliance_names = name_1 | append: "|" | append: name_2 | split: "|" -%}
<div class="layout layout--col gap--small">
{%- if ok != true -%}
  <div class="flex flex--col flex--center gap--small w--full">
    <span class="title">{% if setup %}Set up Agile Octopus prices{% else %}Prices unavailable{% endif %}</span>
    <span class="label label--small">{% if setup %}Choose your electricity region in the plugin settings on trmnl.com.{% else %}{{ error | default: "No data fetched yet" }}{% endif %}</span>
  </div>
{%- else -%}
  <div class="flex flex--col flex--left">
    <span class="label label--small">Now · {{ now.time }}–{{ now.end }}</span>
    <span class="value value--xlarge value--tnums">{{ now.price }}p</span>
    <span class="label label--small">{{ now.vs_reference_pct | abs }}% {% if now.vs_reference_pct < 0 %}below{% else %}above{% endif %} {{ reference.short }}</span>
  </div>
  <div class="grid grid--cols-2 gap--medium">
    <div class="flex flex--col flex--left">
      <span class="label label--small">Next</span>
      <span class="value value--base value--tnums">{% if next %}{{ next.price }}p{% else %}–{% endif %}</span>
    </div>
    <div class="flex flex--col flex--left">
      <span class="label label--small">Cheapest · {{ stats.min.time }}</span>
      <span class="value value--base value--tnums">{{ stats.min.price }}p</span>
    </div>
  </div>
  {%- for w in windows limit: 2 -%}
  <div class="flex flex--col flex--left">
    <span class="label label--small">{{ appliance_names[forloop.index0] }} · {{ w.hours }}h</span>
    {%- if w.available -%}
    <span class="value value--small value--tnums">{{ w.day }} {{ w.start }}–{{ w.end }} · {{ w.average }}p</span>
    {%- else -%}
    <span class="value value--xsmall">Not enough prices</span>
    {%- endif -%}
  </div>
  {%- endfor -%}
{%- endif -%}
</div>

<div class="title_bar">
  <span class="title">Agile Octopus</span>
  <span class="instance">{% if ok == true %}{{ region.name }}{% else %}setup needed{% endif %}</span>
</div>
