{%- assign fields = trmnl.plugin_settings.custom_fields_values -%}
{%- assign name_1 = fields.appliance_1 | default: "Appliance 1" -%}
{%- assign name_2 = fields.appliance_2 | default: "Appliance 2" -%}
{%- assign appliance_names = name_1 | append: "|" | append: name_2 | split: "|" -%}
{%- comment -%}
  Half vertical. On TRMNL X the current price grows and the chart fills the
  extra height, drawn with larger text in portrait where the slot is narrower.
{%- endcomment -%}
<div class="layout layout--col gap--small">
{%- if ok != true -%}
  <div class="flex flex--col flex--center gap--small w--full">
    <span class="title lg:title--large">{% if setup %}Set up Agile Octopus prices{% else %}Prices unavailable{% endif %}</span>
    <span class="label label--small lg:label--base">{% if setup %}Choose your electricity region in the plugin settings on trmnl.com.{% else %}{{ error | default: "No data fetched yet" }}{% endif %}</span>
  </div>
{%- else -%}
  <div class="flex flex--col flex--left lg:w--full">
    <span class="label label--small lg:label--base">Now · {{ now.time }}–{{ now.end }}</span>
    <span class="value value--xlarge lg:value--xxlarge value--tnums">{{ now.price }}p</span>
    <span class="label label--small lg:label--base">{{ now.vs_reference_pct | abs }}% {% if now.vs_reference_pct < 0 %}below{% else %}above{% endif %} {{ reference.short }}</span>
  </div>
  <div class="grid grid--cols-2 gap--medium w--full">
    <div class="flex flex--col flex--left">
      <span class="label label--small lg:label--base">Next</span>
      <span class="value value--base lg:value--large value--tnums">{% if next %}{{ next.price }}p{% else %}–{% endif %}</span>
    </div>
    <div class="flex flex--col flex--left">
      <span class="label label--small lg:label--base">Cheapest · {{ stats.min.time }}</span>
      <span class="value value--base lg:value--large value--tnums">{{ stats.min.price }}p</span>
    </div>
  </div>
  <span class="label label--small lg:label--base">Cheapest {{ stats.min.price }}p at {{ stats.min.time }} · peak {{ stats.max.price }}p · until {{ window.until }}</span>
  {%- render "agile_chart", slots: slots, windows: windows, chart: chart, reference: reference, slot_count: window.slot_count, names: appliance_names, cls: "hidden lg:block lg:portrait:hidden w--full h--56 flex-none", plot_h: 380, ts: 34, pid: "agile-hv-x", hatch: false, labels: false, now: false -%}
  {%- render "agile_chart", slots: slots, windows: windows, chart: chart, reference: reference, slot_count: window.slot_count, names: appliance_names, cls: "hidden lg:portrait:block w--full h--96 flex-none", plot_h: 980, ts: 44, pid: "agile-hv-xp", hatch: false, labels: false, now: false -%}
  {%- if windows.size > 0 -%}
  {%- for w in windows limit: 2 -%}
  <div class="flex flex--col flex--left lg:w--full">
    <span class="label label--small lg:label--base">{{ appliance_names[forloop.index0] }} · {{ w.hours }}h</span>
    {%- if w.available -%}
    <span class="value value--small value--tnums">{{ w.day }} {{ w.start }}–{{ w.end }} · {{ w.average }}p</span>
    {%- else -%}
    <span class="value value--xsmall">Not enough prices</span>
    {%- endif -%}
  </div>
  {%- endfor -%}
  {%- endif -%}
{%- endif -%}
</div>

<div class="title_bar">
  <span class="title">Agile Octopus</span>
  <span class="instance">{% if ok == true %}{{ region.name }}{% else %}setup needed{% endif %}</span>
</div>
